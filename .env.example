# Create a fresh key in Google AI Studio. Never commit the real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Stable assignment. Prefer a dedicated monitor for agent work.
# active-window | active-monitor | desktop | monitor:3 | hwnd:12345 | process:chrome | window:DeFy Tickets
AGENT_OS_TARGET=monitor:3
AGENT_OS_MAX_STEPS=40
AGENT_OS_REPEAT_LIMIT=3
AGENT_OS_STEP_DELAY_SECONDS=0.8

# auto uses an isolated Playwright browser for websites and UI Automation for desktop apps.
AGENT_OS_CONTROL_MODE=auto
AGENT_OS_BROWSER_BACKEND=isolated
AGENT_OS_BROWSER_CHANNEL=chrome
AGENT_OS_BROWSER_PROFILE_DIR=.agent-os/browser-profile
AGENT_OS_BROWSER_TIMEOUT_MS=20000
AGENT_OS_BROWSER_SMOKE_MAX_LINKS=60

# cooperative never steals foreground for physical fallback. deny prevents real mouse/keyboard use.
AGENT_OS_CONFLICT_POLICY=cooperative
AGENT_OS_PHYSICAL_INPUT_POLICY=deny
AGENT_OS_CURSOR_ACTIVITY_GUARD=true
AGENT_OS_RESTORE_USER_CURSOR=true
AGENT_OS_MOVE_BOUND_WINDOW_TO_MONITOR=true

# Pixels, UI metadata, and action target must share one lease identity.
AGENT_OS_STRICT_CAPTURE_ALIGNMENT=true
AGENT_OS_SAVE_SCREENSHOTS=true
AGENT_OS_USE_UIA=true
AGENT_OS_OVERLAY_ENABLED=true
AGENT_OS_CONFIRM_RISKY=true
AGENT_OS_VERIFY_DONE=true
AGENT_OS_ALLOW_UNLISTED_APPS=false
