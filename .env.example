# Select one provider: gemini | openai | mistral
WINDOWS_AGENT_PROVIDER=gemini
WINDOWS_AGENT_MODEL=

# Add only the key for the provider you selected.
GEMINI_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Optional provider-specific model fallbacks. WINDOWS_AGENT_MODEL wins when set.
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-5-mini
MISTRAL_MODEL=mistral-small-latest

# Stable assignment. Prefer a dedicated monitor for agent work.
# active-window | active-monitor | desktop | monitor:3 | hwnd:12345 | process:chrome | window:DeFy Tickets
WINDOWS_AGENT_TARGET=monitor:3
WINDOWS_AGENT_MAX_STEPS=40
WINDOWS_AGENT_REPEAT_LIMIT=3
WINDOWS_AGENT_STEP_DELAY_SECONDS=0.8
WINDOWS_AGENT_API_TIMEOUT_MS=30000

# auto uses an isolated Playwright browser for websites and UI Automation for desktop apps.
WINDOWS_AGENT_CONTROL_MODE=auto
WINDOWS_AGENT_BROWSER_BACKEND=isolated
WINDOWS_AGENT_BROWSER_CHANNEL=chrome
WINDOWS_AGENT_BROWSER_PROFILE_DIR=.windows-agent/browser-profile
WINDOWS_AGENT_BROWSER_TIMEOUT_MS=20000
WINDOWS_AGENT_BROWSER_SMOKE_MAX_LINKS=60
WINDOWS_AGENT_BROWSER_SMOKE_VISUAL_DELAY_MS=350

# cooperative never steals foreground for physical fallback. deny prevents real mouse/keyboard use.
WINDOWS_AGENT_CONFLICT_POLICY=cooperative
WINDOWS_AGENT_PHYSICAL_INPUT_POLICY=deny
WINDOWS_AGENT_CURSOR_ACTIVITY_GUARD=true
WINDOWS_AGENT_RESTORE_USER_CURSOR=true
WINDOWS_AGENT_MOVE_BOUND_WINDOW_TO_MONITOR=true

# Pixels, UI metadata, and action target must share one lease identity.
WINDOWS_AGENT_STRICT_CAPTURE_ALIGNMENT=true
WINDOWS_AGENT_SAVE_SCREENSHOTS=true
WINDOWS_AGENT_USE_UIA=true
WINDOWS_AGENT_OVERLAY_ENABLED=true
WINDOWS_AGENT_CONFIRM_RISKY=true
WINDOWS_AGENT_VERIFY_DONE=true
WINDOWS_AGENT_ALLOW_UNLISTED_APPS=false

# Legacy AGENT_OS_* variables remain accepted during the migration period.
